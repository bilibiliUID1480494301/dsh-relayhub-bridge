{
  "name": "dsh-relayhub-bridge",
  "version": "0.1.3",
  "description": "DeepSeek Harness bridge to a relay-hub station: TOIP dynamic-password onboarding, LAN discovery, and per-plugin log accounting",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "relayhub",
    "relay-hub",
    "llm",
    "gateway",
    "toip",
    "totp",
    "anthropic"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./protocol": {
      "types": "./lib/protocol.d.ts",
      "default": "./lib/protocol.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "name": "relayhub-bridge",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/",
    "check": "node scripts/check-package.cjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bilibiliUID1480494301/dsh-relayhub-bridge.git"
  },
  "homepage": "https://github.com/bilibiliUID1480494301/dsh-relayhub-bridge#readme",
  "bugs": {
    "url": "https://github.com/bilibiliUID1480494301/dsh-relayhub-bridge/issues"
  }
}
